# ==============================================================================
# FinSight Environment Configuration Template
# Copy this file to .env and configure your local or cloud environment values.
# ==============================================================================

# Database Configuration (PostgreSQL / Supabase)
# For local PostgreSQL:
# SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/finsight
# For Supabase Session Pooler:
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/finsight
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your_database_password_here

# AI Forensic Investigation Settings (Google Gemini 1.5 Flash)
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_TIMEOUT_MS=5000

# Role-Based Access Control Credentials
SECURITY_OPERATOR_USERNAME=operator
SECURITY_OPERATOR_PASSWORD=operator123
SECURITY_ANALYST_USERNAME=analyst
SECURITY_ANALYST_PASSWORD=analyst123
SECURITY_ADMIN_USERNAME=admin
SECURITY_ADMIN_PASSWORD=admin123

# Frontend CORS Configuration (Comma-separated origins)
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500
