# ==============================================================================
# FinSight Frontend Environment Variables — Example Template
# ==============================================================================
# This file documents required environment variables for the frontend.
# DO NOT commit real values to this file.
#
# For local development: Copy to .env.local and customize
# For Vercel deployment: Set these in the Vercel dashboard environment settings
# ==============================================================================

# Backend API Base URL
# ---------------------
# The deployed Railway backend URL
# Development: Leave empty to use Vite proxy (forwards to localhost:8080)
# Production: Set to your Railway deployment URL

VITE_API_BASE_URL=https://finsight-production-f61a.up.railway.app

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
# - Do NOT put backend secrets (database passwords, API keys) in frontend env
# - Frontend env vars are PUBLIC and visible in the browser bundle
# - Only put the backend API URL here
# ==============================================================================
